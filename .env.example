# Адрес API для серверного рендера (внутренний) и для браузера (публичный).
NUXT_API_BASE=http://127.0.0.1:8000/api
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Временно, до входа: организация, от имени которой публикует форма.
NUXT_PUBLIC_DEV_ORGANIZATION_ID=

# Служебные вызовы бэка (визиты, исходный файл текстов) — тот же секрет,
# что INTERNAL_TOKEN бэка. Пусто — визиты не шлются.
NUXT_INTERNAL_TOKEN=

# Страна посетителя: заголовок CDN, иначе GeoIP-база (GeoLite2-Country.mmdb).
NUXT_COUNTRY_HEADER=cf-ipcountry
NUXT_GEOIP_DATABASE=
# Доверять X-Forwarded-For (только за своим прокси).
NUXT_TRUST_FORWARDED_FOR=false
